{
  "name": "hear",
  "version": "0.3.7",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint && prettier --check \"src/**/*.{ts,html,scss}\" \"*.{ts,js,cjs,json}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{ts,js,cjs,json}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\"",
    "e2e": "playwright test",
    "verify": "node scripts/verify-no-fakes.mjs",
    "apk:debug": "node scripts/build-debug-apk.mjs",
    "cap:sync": "npm run build && cap sync android"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@ionic/angular": "^8.8.19",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.1.0"
  }
}
